# Supabase Configuration
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Groq AI API (https://console.groq.com - free tier)
VITE_GROQ_API_KEY=your-groq-api-key-here

# Supabase Service Role (for Edge Functions only - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Automation Worker Polling Interval (ms)
AUTOMATION_POLL_INTERVAL=60000

# AI Assistant Model
AI_MODEL=openai/gpt-oss-20b
VITE_AI_MODEL=openai/gpt-oss-20b